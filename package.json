{
  "name": "cinera-streaming-portal",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy --keep-vars --secrets-file .env",
    "check": "node --check worker/index.js && node --check worker/catalog.js && node --check worker/seed.js && node --check worker/sources.js",
    "test": "node --test",
    "test:browser": "node scripts/browser/run.mjs",
    "validate": "npm run check && npm test && npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "abortcontroller-polyfill": "^1.7.8",
    "hls.js": "^1.5.18",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "url-search-params-polyfill": "^8.2.5",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "terser": "^5.51.2",
    "vite": "^6.0.5",
    "wrangler": "^4.156.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
